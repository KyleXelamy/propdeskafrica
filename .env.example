# PropDesk Africa — environment template
#
# Copy to `.env.local` (development) or set every variable in your hosting
# provider's dashboard (production). NEVER commit a filled-in copy of this file.
#
#   cp .env.example .env.local
#
# A variable that is marked REQUIRED has no safe default. The application is
# designed to FAIL CLOSED when a required secret is absent — that is deliberate,
# not a bug. See HARDENING_RUNBOOK.md for the generation command of each key.

# ---------------------------------------------------------------------------
# Public (safe to expose to the browser — these end up in the client bundle)
# ---------------------------------------------------------------------------

# Required. The public origin of the deployment, no trailing slash.
# Used for OAuth redirects, M-Pesa callbacks and absolute links in emails.
NEXT_PUBLIC_APP_URL="https://app.propdesk.africa"

# Optional. Commit SHA or build identifier shown in the dashboard footer.
NEXT_PUBLIC_APP_COMMIT=""

# Required (production). Supabase project URL — same value as Vercel env.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Required (production). Supabase anon/public API key.
# This key is designed to be public. Protection comes from RLS and from the
# server-side session check, not from hiding this value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional. Local development only — extra redirect URL allowed in development.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL="http://localhost:3000/auth/callback"

# ---------------------------------------------------------------------------
# Supabase (server-side only — NEVER prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Required. Service-role key. Grants full access bypassing RLS.
# Rotate in the Supabase dashboard if it ever appears in a log, a commit or a
# chat message. Rotating it invalidates every session that used the old value.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional. Email address that receives Nominatim (geocoding) usage notices.
NOMINATIM_EMAIL=""

# ---------------------------------------------------------------------------
# Primary database (Neon Postgres, accessed over HTTP)
# ---------------------------------------------------------------------------

# Required (production). Neon pooled connection string.
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=""

# Fallback connection strings, used only when DATABASE_URL is empty.
# The app resolves: DATABASE_URL -> POSTGRES_URL -> POSTGRES_PRISMA_URL
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""

# ---------------------------------------------------------------------------
# Encryption at rest (required once the encryption rollout starts)
# ---------------------------------------------------------------------------

# Required before running `npm run db:encrypt-backfill`.
# A JSON registry mapping a key id to a base64 32-byte AES-256 key.
#   PROPDESK_ENCRYPTION_KEYS='{"v1":"<base64 32 bytes>"}'
# Generate: openssl rand -base64 32
# To rotate: add a new id ("v2") alongside the old one, deploy, backfill, then
# remove the old id in a later deploy. Never remove a key id that is still in use.
PROPDESK_ENCRYPTION_KEYS=""

# Optional single-key shorthand. Used ONLY when PROPDESK_ENCRYPTION_KEYS is
# unset. Equivalent to {"v1":"<value>"}. Do not set both during a rotation.
PROPDESK_ENCRYPTION_KEY=""

# Required for searchable encrypted columns (email, phone, msisdn).
# MUST be a DIFFERENT key from the encryption key above — reusing one key for
# two purposes breaks the security properties of both.
#   PROPDESK_BLIND_INDEX_KEYS='{"b1":"<base64 32 bytes>"}'
# Generate: openssl rand -base64 32
PROPDESK_BLIND_INDEX_KEYS=""

# Optional single-key shorthand for the blind index. Equivalent to {"b1":"..."}.
PROPDESK_BLIND_INDEX_KEY=""

# ---------------------------------------------------------------------------
# Server secrets (required in production — the app returns 503 without them)
# ---------------------------------------------------------------------------

# Required. Shared secret for POST /api/migrations/run and /api/migrations/reset.
# Generate: openssl rand -hex 32
MIGRATION_SECRET=""

# Required. Shared secret for POST /api/cron/run.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# Required. Shared secret for POST /api/backup/auto.
# Generate: openssl rand -hex 32
BACKUP_CRON_SECRET=""

# Optional. Salt for the in-memory rate limiter.
# Any long random string; it scopes per-instance counters so that a restart
# does not inherit a previous window. Generate: openssl rand -hex 16
RATE_LIMIT_SALT=""

# ---------------------------------------------------------------------------
# Safaricom Daraja (M-Pesa)
# ---------------------------------------------------------------------------

# Required. Which Daraja environment this deployment talks to.
# Allowed values: "production" | "sandbox".
# IMPORTANT: an UNSET or BLANK value is treated as NOT sandbox. Never rely on
# the unset state to mean "sandbox" — set it explicitly in every environment.
MPESA_ENV="sandbox"

# Required. The paybill / till number (shortcode).
MPESA_SHORTCODE=""

# Required. The M-Pesa initiator name shown in the customer's phone prompt.
MPESA_INITIATOR_NAME=""

# Required (production). OAuth consumer key from Daraja.
MPESA_CONSUMER_KEY=""

# Required (production). OAuth consumer secret.
MPESA_CONSUMER_SECRET=""

# Required (production). Initiator security credential (passcode).
MPESA_SECURITY_CREDENTIAL=""

# Optional (production). Passkey, only if your Daraja account is issued one.
MPESA_PASSKEY=""

# Required. The base URL of the callback endpoint Safaricom posts to.
# Usually the public URL of your own deployment, e.g.
#   https://app.propdesk.africa/api/mpesa/callback
MPESA_CALLBACK_URL=""

# Optional. Shared secret echoed by Safaricom in the callback, used as a second
# factor alongside the IP allowlist. Strongly recommended.
MPESA_CALLBACK_SECRET=""

# Required (production). Comma-separated list of Safaricom callback IP
# addresses. If this is UNSET or EMPTY, callbacks are REJECTED (fail closed).
# Get the current list from Safaricom's Daraja documentation — do not guess it,
# and do not set it to 0.0.0.0/0.
MPESA_ALLOWED_CALLBACK_IPS=""

# Development only. When set to "1", the M-Pesa client returns a simulated
# response instead of calling Daraja. The mock path is only reachable when
# MPESA_ENV is explicitly "sandbox" AND NODE_ENV is not "production".
# NEVER set this in production.
MPESA_SANDBOX_MOCK=""

# Optional. Comma-separated list of owner/operator email addresses that are
# allowed to reconfigure the platform-wide Daraja callback URLs via
# POST /api/mpesa/c2b/register. If unset, that endpoint refuses everyone.
MPESA_ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Required if Stripe checkout is enabled. Secret key from the Stripe dashboard.
STRIPE_SECRET_KEY=""

# Required if Stripe checkout is enabled. Signing secret of the webhook
# endpoint. This exact value must match what is configured in Stripe, because
# the webhook signature is verified against the raw request body.
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Platform (set by the hosting provider — usually already present)
# ---------------------------------------------------------------------------

# Set automatically by Vercel.
VERCEL_URL=""

# Set automatically by the hosting provider. Use "development" locally.
NODE_ENV="production"
